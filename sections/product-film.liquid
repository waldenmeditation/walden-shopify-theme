{% comment %}
  Product film — "See it in use". One template serves all products: each
  block maps a product to a portrait (9:16) video, and the section renders
  only on matching product pages (nothing at all elsewhere). Videos autoplay
  muted while in view; a sound toggle unmutes the narrated cuts. Styling
  follows the B2B landing language: quiet type, warm tint, hairline accents.
{% endcomment %}

{%- liquid
  assign film = blank
  for block in section.blocks
    assign bh = block.settings.product_handle | strip | downcase
    if bh == blank
      continue
    endif
    if bh == product.handle
      if block.settings.video != blank or block.settings.video_file != blank
        assign film = block
        break
      endif
    endif
  endfor
-%}

{%- if film != blank -%}
  {{ 'section-product-film.css' | asset_url | stylesheet_tag }}
  <section class="product-film">
    <div class="product-film__inner">
      <figure class="product-film__media" {{ film.shopify_attributes }}>
        {%- if film.settings.video != blank -%}
          {{ film.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '900x' }}
        {%- else -%}
          <video
            src="{{ film.settings.video_file | asset_url }}"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
            aria-label="{{ section.settings.heading | default: 'Product video' | escape }}"
          ></video>
        {%- endif -%}
        <button type="button" class="product-film__sound" aria-pressed="false" aria-label="Unmute video" hidden>
          <svg class="product-film__icon product-film__icon--off" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2.5 4.5 5.5H2v5h2.5L8 13.5v-11Z" fill="currentColor"/>
            <path d="m10.5 6 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <svg class="product-film__icon product-film__icon--on" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2.5 4.5 5.5H2v5h2.5L8 13.5v-11Z" fill="currentColor"/>
            <path d="M10.5 5.5a3.6 3.6 0 0 1 0 5M12 3.5a6 6 0 0 1 0 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
      </figure>
      <div class="product-film__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-film__heading pdp-reveal">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if film.settings.body != blank -%}
          <div class="product-film__body pdp-reveal">{{ film.settings.body }}</div>
        {%- endif -%}
        {%- if film.settings.bullets != blank -%}
          <div class="product-film__bullets pdp-reveal">{{ film.settings.bullets }}</div>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <div class="product-film__cta pdp-reveal">
            <button type="button" class="pdp-link" data-pdp-scroll-buy>{{ section.settings.cta_text }}</button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  <script src="{{ 'product-film.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pdp-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product film",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it in use" },
    { "type": "text", "id": "cta_text", "label": "Button text", "info": "Scrolls back to the buy box. Leave blank to hide.", "default": "Choose yours" },
    { "type": "text", "id": "cta_note", "label": "Note beside button" }
  ],
  "blocks": [
    {
      "type": "film",
      "name": "Product video",
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Product handle", "info": "The video shows only on this product's page, e.g. breathwork." },
        { "type": "video", "id": "video", "label": "Video", "info": "Portrait (9:16) hosted video. Takes priority over the asset filename." },
        { "type": "text", "id": "video_file", "label": "Theme asset video", "info": "Filename of an .mp4 in the theme's assets." },
        { "type": "richtext", "id": "body", "label": "Text beside the video" },
        { "type": "richtext", "id": "bullets", "label": "Bullet list", "info": "Rendered as hairline rows under the text." }
      ]
    }
  ],
  "presets": [
    { "name": "Product film" }
  ]
}
{% endschema %}
