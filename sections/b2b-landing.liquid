{% comment %}
  B2B landing (Hospitality & Studio / Retail Partners / Corporate Gifting).
  One continuous, conversion-focused flow: hero with inline trust, benefits
  grid, collection image band, 3-step process, single statement, native
  inquiry form. Type and color come from the theme (Geist + color schemes);
  warm tones derive from --color-border. Program tabs swap instantly via
  assets/b2b-landing.js while each program keeps its own URL.
{% endcomment %}

{{ 'section-b2b-landing.css' | asset_url | stylesheet_tag }}

<div class="b2b color-{{ section.settings.color_scheme }}">

  {%- comment -%} ---------- PROGRAM TABS ---------- {%- endcomment -%}
  {%- if section.settings.show_switcher -%}
    {%- assign active_tab = section.settings.active_tab -%}
    <nav class="b2b-tabs" aria-label="Trade programs">
      {%- render 'hosp-switcher-tab', label: section.settings.tab1_label, url: section.settings.tab1_url, id: 'tab1', active_tab: active_tab -%}
      {%- render 'hosp-switcher-tab', label: section.settings.tab2_label, url: section.settings.tab2_url, id: 'tab2', active_tab: active_tab -%}
      {%- render 'hosp-switcher-tab', label: section.settings.tab3_label, url: section.settings.tab3_url, id: 'tab3', active_tab: active_tab -%}
    </nav>
  {%- endif -%}

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="b2b-hero">
    {%- if section.settings.hero_image != blank -%}
      <img
        class="b2b-hero__bg"
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        srcset="{{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
                {{ section.settings.hero_image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.hero_image.alt | escape }}"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="b2b-hero__scrim"></div>
    <div class="b2b__inner b2b-hero__content color-scheme-6">
      <div class="b2b-hero__copy">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="b2b-eyebrow b2b-eyebrow--light">{{ section.settings.hero_eyebrow }}</p>
        {%- endif -%}
        <h1 class="b2b-hero__title">{{ section.settings.hero_title }}</h1>
        {%- if section.settings.hero_lead != blank -%}
          <div class="b2b-hero__lead">{{ section.settings.hero_lead }}</div>
        {%- endif -%}
        <div class="b2b-hero__actions">
          <a href="#inquire" class="button button-secondary b2b-hero__cta">{{ section.settings.hero_cta_text | default: 'Start an inquiry' }}</a>
          {%- if section.settings.hero_note != blank -%}
            <span class="b2b-hero__note">{{ section.settings.hero_note }}</span>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.trust_logos != blank -%}
        <div class="b2b-hero__trust">
          {%- if section.settings.trust_label != blank -%}
            <span class="b2b-eyebrow b2b-eyebrow--light">{{ section.settings.trust_label }}</span>
          {%- endif -%}
          <div class="b2b-hero__logos">
            {%- assign trust_logos = section.settings.trust_logos | split: ',' -%}
            {%- for logo in trust_logos -%}
              {%- liquid
                assign logo_name = logo | strip
                assign logo_key = logo_name | downcase | remove: "'" | remove: '’' | remove: '.' | replace: ' ', '-'
                assign logo_asset = 'trust-logo-' | append: logo_key | append: '.svg'
              -%}
              <img
                class="b2b-hero__logo"
                src="{{ logo_asset | asset_url }}"
                alt="{{ logo_name | escape }}"
                width="110"
                height="24"
                loading="lazy"
                onerror="var s=document.createElement('span');s.className='b2b-hero__logo-text';s.textContent=this.alt;this.replaceWith(s)"
              >
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </header>

  {%- comment -%} ---------- BENEFITS ---------- {%- endcomment -%}
  {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefit_blocks.size > 0 -%}
    <section class="b2b-benefits b2b-reveal" aria-label="What you get">
      <div class="b2b__inner">
        {%- if section.settings.benefits_heading != blank -%}
          <h2 class="b2b-benefits__heading">{{ section.settings.benefits_heading }}</h2>
        {%- endif -%}
        <div class="b2b-benefits__grid">
          {%- for block in benefit_blocks -%}
            <div class="b2b-benefit" {{ block.shopify_attributes }}>
              <span class="b2b-benefit__index">{{ forloop.index | prepend: '0' }}</span>
              <h3 class="b2b-benefit__title">{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="b2b-benefit__body">{{ block.settings.body }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- MEDIA BAND (video with image fallback) ---------- {%- endcomment -%}
  {%- if section.settings.band_video != blank or section.settings.band_video_url != blank or section.settings.band_image != blank -%}
    <section class="b2b-band b2b-reveal">
      {%- if section.settings.band_video != blank -%}
        {{ section.settings.band_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1400x' }}
      {%- elsif section.settings.band_video_url != blank -%}
        <div class="b2b-band__embed">
          {%- if section.settings.band_video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.band_video_url.id }}?rel=0&modestbranding=1" title="{{ section.settings.band_caption | default: 'Walden video' | escape }}" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
          {%- elsif section.settings.band_video_url.type == 'vimeo' -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.band_video_url.id }}?dnt=1" title="{{ section.settings.band_caption | default: 'Walden video' | escape }}" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
          {%- endif -%}
        </div>
      {%- elsif section.settings.band_image != blank -%}
        <img
          src="{{ section.settings.band_image | image_url: width: 2400 }}"
          srcset="{{ section.settings.band_image | image_url: width: 1200 }} 1200w,
                  {{ section.settings.band_image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.band_image.alt | escape }}"
          width="{{ section.settings.band_image.width }}"
          height="{{ section.settings.band_image.height }}"
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.band_caption != blank -%}
        <p class="b2b-band__caption b2b-eyebrow">{{ section.settings.band_caption }}</p>
      {%- endif -%}
    </section>
  {%- endif -%}

  {%- comment -%} ---------- CASE STUDIES ---------- {%- endcomment -%}
  {%- assign case_blocks = section.blocks | where: 'type', 'case_study' -%}
  {%- if case_blocks.size > 0 -%}
    <section class="b2b-cases b2b-reveal" aria-label="Selected work">
      <div class="b2b__inner">
        {%- if section.settings.cases_heading != blank -%}
          <h2 class="b2b-cases__heading">{{ section.settings.cases_heading }}</h2>
        {%- endif -%}
        <div class="b2b-cases__grid" style="--b2b-cases-cols: {% if case_blocks.size >= 3 %}3{% else %}2{% endif %};">
          {%- for block in case_blocks -%}
            <article class="b2b-case" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  class="b2b-case__image"
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="{{ block.settings.image | image_url: width: 700 }} 700w,
                          {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 900px) 50vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.meta != blank -%}
                <p class="b2b-eyebrow b2b-case__meta">{{ block.settings.meta }}</p>
              {%- endif -%}
              <h3 class="b2b-case__title">{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="b2b-case__body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.stat != blank -%}
                <p class="b2b-case__stat">
                  <span class="b2b-case__stat-value">{{ block.settings.stat }}</span>
                  {%- if block.settings.stat_label != blank -%}
                    <span class="b2b-case__stat-label">{{ block.settings.stat_label }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- VERTICAL VIDEOS ---------- {%- endcomment -%}
  {%- assign reel_blocks = section.blocks | where: 'type', 'vertical_video' -%}
  {%- if reel_blocks.size > 0 -%}
    <section class="b2b-reels b2b-reveal" aria-label="Videos">
      <div class="b2b__inner">
        {%- if section.settings.reels_heading != blank -%}
          <h2 class="b2b-reels__heading">{{ section.settings.reels_heading }}</h2>
        {%- endif -%}
        <div class="b2b-reels__grid" style="--b2b-reels-cols: {{ reel_blocks.size | at_most: 4 }};">
          {%- for block in reel_blocks -%}
            <figure class="b2b-reel" {{ block.shopify_attributes }}>
              <div class="b2b-reel__media">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '800x' }}
                {%- elsif block.settings.poster != blank -%}
                  <img
                    src="{{ block.settings.poster | image_url: width: 800 }}"
                    srcset="{{ block.settings.poster | image_url: width: 500 }} 500w,
                            {{ block.settings.poster | image_url: width: 800 }} 800w"
                    sizes="(min-width: 900px) 30vw, 72vw"
                    alt="{{ block.settings.poster.alt | default: block.settings.caption | escape }}"
                    width="{{ block.settings.poster.width }}"
                    height="{{ block.settings.poster.height }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption class="b2b-eyebrow">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- HOW IT WORKS ---------- {%- endcomment -%}
  {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
  {%- if step_blocks.size > 0 -%}
    <section class="b2b-steps b2b-reveal" aria-label="How it works">
      <div class="b2b__inner">
        {%- if section.settings.steps_heading != blank -%}
          <h2 class="b2b-steps__heading">{{ section.settings.steps_heading }}</h2>
        {%- endif -%}
        <ol class="b2b-steps__list">
          {%- for block in step_blocks -%}
            <li class="b2b-step" {{ block.shopify_attributes }}>
              <h3 class="b2b-step__title">{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}
                <div class="b2b-step__body">{{ block.settings.body }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- GALLERY STRIP ---------- {%- endcomment -%}
  {%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
  {%- if gallery_blocks.size > 0 -%}
    <section class="b2b-gallery b2b-reveal" aria-label="Gallery">
      <div class="b2b__inner">
        <div class="b2b-gallery__grid" style="--b2b-gallery-cols: {{ gallery_blocks.size | at_most: 4 }};">
          {%- for block in gallery_blocks -%}
            <figure class="b2b-gallery__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 500 }} 500w,
                          {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 900px) 33vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <figcaption class="b2b-eyebrow">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- STATEMENT ---------- {%- endcomment -%}
  {%- if section.settings.statement != blank -%}
    <section class="b2b-statement b2b-reveal">
      <div class="b2b__inner b2b-statement__inner">
        <div class="b2b-statement__text">{{ section.settings.statement }}</div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- INQUIRY FORM ---------- {%- endcomment -%}
  <section id="inquire" class="b2b-form b2b-reveal">
    <div class="b2b__inner b2b-form__inner">
      <div class="b2b-form__head">
        {%- if section.settings.form_title != blank -%}
          <h2 class="b2b-form__title">{{ section.settings.form_title }}</h2>
        {%- endif -%}
        {%- if section.settings.form_subtitle != blank -%}
          <div class="b2b-form__sub">{{ section.settings.form_subtitle }}</div>
        {%- endif -%}
      </div>
      {%- render 'b2b-inquiry-form',
        program: section.settings.form_program,
        company_label: section.settings.form_company_label,
        type_label: section.settings.form_type_label,
        type_options: section.settings.form_type_options,
        size_label: section.settings.form_size_label,
        size_placeholder: section.settings.form_size_placeholder,
        submit_label: section.settings.form_submit_label,
        footnote: section.settings.form_footnote
      -%}
    </div>
  </section>

</div>

<script src="{{ 'b2b-landing.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "B2B landing",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Program switcher" },
    { "type": "checkbox", "id": "show_switcher", "label": "Show program tabs", "default": true },
    { "type": "select", "id": "active_tab", "label": "Active tab", "options": [ { "value": "tab1", "label": "Tab 1" }, { "value": "tab2", "label": "Tab 2" }, { "value": "tab3", "label": "Tab 3" } ], "default": "tab1" },
    { "type": "text", "id": "tab1_label", "label": "Tab 1 label", "default": "Hospitality & Studio" },
    { "type": "text", "id": "tab1_url", "label": "Tab 1 link" },
    { "type": "text", "id": "tab2_label", "label": "Tab 2 label", "default": "Retail Partners" },
    { "type": "text", "id": "tab2_url", "label": "Tab 2 link" },
    { "type": "text", "id": "tab3_label", "label": "Tab 3 label", "default": "Corporate Gifting" },
    { "type": "text", "id": "tab3_url", "label": "Tab 3 link" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "A room for rest, within yours." },
    { "type": "richtext", "id": "hero_lead", "label": "Lead" },
    { "type": "text", "id": "hero_cta_text", "label": "Button text", "default": "Start an inquiry" },
    { "type": "text", "id": "hero_note", "label": "Note beside button", "info": "e.g. We reply within one business day." },
    { "type": "text", "id": "trust_label", "label": "Trust label" },
    { "type": "text", "id": "trust_logos", "label": "Partner names", "info": "Comma-separated; maps to assets/trust-logo-<name>.svg with text fallback." },
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "benefits_heading", "label": "Heading" },
    { "type": "header", "content": "Media band" },
    { "type": "video", "id": "band_video", "label": "Video", "info": "Hosted video; plays muted on loop. Takes priority over the URL and image." },
    { "type": "video_url", "id": "band_video_url", "label": "Video URL", "accept": ["youtube", "vimeo"], "info": "Used if no hosted video is set." },
    { "type": "image_picker", "id": "band_image", "label": "Image (fallback)" },
    { "type": "text", "id": "band_caption", "label": "Caption" },
    { "type": "header", "content": "Case studies" },
    { "type": "text", "id": "cases_heading", "label": "Heading", "default": "Selected spaces" },
    { "type": "header", "content": "Vertical videos" },
    { "type": "text", "id": "reels_heading", "label": "Heading", "default": "In motion" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "How it works" },
    { "type": "header", "content": "Statement" },
    { "type": "richtext", "id": "statement", "label": "Statement" },
    { "type": "header", "content": "Inquiry form" },
    { "type": "text", "id": "form_title", "label": "Title" },
    { "type": "richtext", "id": "form_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "form_program", "label": "Program tag", "info": "Included in the submission, e.g. Hospitality & Studio.", "default": "Hospitality & Studio" },
    { "type": "text", "id": "form_company_label", "label": "Company field label", "default": "Property / company" },
    { "type": "text", "id": "form_type_label", "label": "Type field label", "default": "Property type" },
    { "type": "text", "id": "form_type_options", "label": "Type options", "info": "Comma-separated select options.", "default": "Hotel, Resort / Retreat, Yoga / Meditation studio, Spa / Wellness center, Other" },
    { "type": "text", "id": "form_size_label", "label": "Size field label", "default": "Rooms or spaces" },
    { "type": "text", "id": "form_size_placeholder", "label": "Size placeholder", "default": "e.g. 40 rooms + 1 studio" },
    { "type": "text", "id": "form_submit_label", "label": "Submit button", "default": "Submit inquiry" },
    { "type": "text", "id": "form_footnote", "label": "Footnote", "default": "We reply within one business day, or write us directly at sales@walden.us." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Volume pricing" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tell us about your space" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    },
    {
      "type": "case_study",
      "name": "Case study",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "meta", "label": "Label", "info": "Small uppercase label, e.g. Member event." },
        { "type": "text", "id": "title", "label": "Title", "default": "Project name" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "stat", "label": "Stat", "info": "Optional highlight, e.g. 120 rooms." },
        { "type": "text", "id": "stat_label", "label": "Stat label", "info": "Small line under the stat, e.g. furnished across two properties." }
      ]
    },
    {
      "type": "vertical_video",
      "name": "Vertical video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Portrait (9:16) hosted video; plays muted on loop while in view." },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown until a video is set." },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "B2B landing",
      "blocks": [
        { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" },
        { "type": "step" }, { "type": "step" }, { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
