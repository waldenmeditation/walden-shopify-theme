{% comment %}
  Sticky add-to-cart bar. Slides up once the main buy button scrolls out
  of view; the button proxies a click to the real add-to-cart button so
  every cart behavior (drawer, errors, variant selection) stays identical.
  Price and availability mirror the main buy box via pdp-story.js.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if product != blank and product.available -%}
  <div class="pdp-atc" data-pdp-atc hidden>
    <div class="pdp-atc__inner">
      {%- if product.featured_media != blank -%}
        <img
          class="pdp-atc__thumb"
          src="{{ product.featured_media | image_url: width: 120 }}"
          alt="{{ product.title | escape }}"
          width="56"
          height="56"
          loading="lazy"
        >
      {%- endif -%}
      <div class="pdp-atc__meta">
        <span class="pdp-atc__title">{{ product.title }}</span>
        <span class="pdp-atc__price" data-pdp-atc-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="button" class="button pdp-atc__button" data-pdp-atc-button>
        {{ section.settings.button_label | default: 'Add to cart' }}
      </button>
    </div>
  </div>
  <script src="{{ 'pdp-story.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  .pdp-atc {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -8px 28px rgb(0 0 0 / 0.06);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  .pdp-atc.is-active {
    transform: translateY(0);
  }
  .pdp-atc[hidden] {
    display: none;
  }
  .pdp-atc__inner {
    max-width: var(--page-width, 1280px);
    margin-inline: auto;
    padding: 10px var(--page-margin, clamp(20px, 5vw, 40px));
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .pdp-atc__thumb {
    width: 44px;
    height: 44px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .pdp-atc__meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    margin-right: auto;
  }
  .pdp-atc__title {
    font-family: var(--font-paragraph--family);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-foreground-heading);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdp-atc__price {
    font-family: var(--font-paragraph--family);
    font-size: 12.5px;
    color: var(--color-foreground-muted);
  }
  .pdp-atc__button {
    flex-shrink: 0;
    min-width: 160px;
  }
  @media screen and (width < 550px) {
    .pdp-atc__thumb { display: none; }
    .pdp-atc__button { min-width: 132px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-atc { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP sticky add to cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" }
  ],
  "presets": [
    { "name": "PDP sticky add to cart" }
  ]
}
{% endschema %}
