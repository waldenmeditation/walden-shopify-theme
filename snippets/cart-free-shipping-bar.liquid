{% doc %}
  Free shipping progress bar for the cart drawer and cart page.
  Threshold comes from settings.free_shipping_threshold (store currency units, 0 hides the bar).
{% enddoc %}

{% stylesheet %}
  .free-shipping-bar {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    padding-block-end: var(--padding-sm);
  }

  .free-shipping-bar__message {
    font-size: var(--cart-font-size--sm, 0.875rem);
    color: var(--color-foreground);
    margin: 0;
  }

  .free-shipping-bar__track {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(from var(--color-foreground) r g b / 0.15);
    overflow: hidden;
  }

  .free-shipping-bar__fill {
    height: 100%;
    border-radius: inherit;
    background-color: var(--color-foreground);
    transition: width 0.3s ease;
  }
{% endstylesheet %}

{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
-%}

{%- if threshold > 0 and cart != empty -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100 | round
  -%}
  <div class="free-shipping-bar" role="status">
    <p class="free-shipping-bar__message">
      {%- if remaining > 0 -%}
        You're {{ remaining | money }} away from free U.S. shipping.
      {%- else -%}
        You've unlocked free U.S. shipping.
      {%- endif -%}
    </p>
    <div class="free-shipping-bar__track">
      <div class="free-shipping-bar__fill" style="width: {{ progress }}%;"></div>
    </div>
  </div>
{%- endif -%}
